# Copy to /etc/tobi-agent.env on the server (chmod 600) and fill in.
# Never commit the filled-in file: it holds keys and the sign-in secret.

# Where the agent keeps its database and files: outside the website folder.
PERSONAL_AGENT_DATA_DIR=/var/lib/tobi-agent

# The agent's name, and what it calls you.
PERSONAL_AGENT_NAME=Agent
PERSONAL_AGENT_OWNER_NAME=Tobi

# Sign-in: run `python -m personal_agent.auth --with-code` and paste the four lines it prints.
PERSONAL_AGENT_OWNER_EMAIL=
PERSONAL_AGENT_OWNER_PASSWORD_HASH=
PERSONAL_AGENT_SESSION_SECRET=
PERSONAL_AGENT_TOTP_SECRET=
# On the server: refuse every request until sign-in is set up.
PERSONAL_AGENT_REQUIRE_LOGIN=1

# Model provider keys, for the routes in config/route_table.yaml (Groq today).
GROQ_API_KEY=
# Web search for research (optional).
EXA_API_KEY=

# Outlook / Microsoft 365 mail and calendar (optional; without them approved mail waits in the outbox).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=
