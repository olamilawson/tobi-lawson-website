{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/writing",
      "destination": "/writing/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/now",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/now/:path*",
      "destination": "/projects",
      "permanent": true
    }
  ]
}
